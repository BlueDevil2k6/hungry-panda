# Hungry Panda — environment configuration
#
# The app runs with ZERO configuration in "demo mode": in-memory data, a
# simulated Google sign-in, and instant (fake) payments. Fill any section
# below to switch that integration to the real service. Copy to `.env.local`.

# --- Sessions -------------------------------------------------------------
# Secret used to sign session cookies. Generate: `openssl rand -base64 32`
SESSION_SECRET=

# --- Admin access ---------------------------------------------------------
# Comma-separated staff emails allowed into the admin console.
ADMIN_ALLOWLIST=marco@hungrypanda.example

# --- Google sign-in (OpenID Connect) --------------------------------------
# When set, the app expects the real Google OAuth redirect flow instead of the
# demo sign-in. Configure the consent screen + credentials in Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Stripe payments ------------------------------------------------------
# When STRIPE_SECRET_KEY is set, checkout creates a real PaymentIntent and the
# webhook finalises the order. Without it, checkout is approved in demo mode.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Supabase (Postgres data layer) --------------------------------------
# When both are set, wire SupabaseStore in src/data/store.ts (see
# supabase/README.md). Without them the in-memory store is used.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
